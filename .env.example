# Local mode needs no keys — the database is PGlite, created on first request
# in .data/pg and seeded from src/lib/data.ts.

# Public site URL, used for canonical links and OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: the same Supabase values used when this schema is pushed for real.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
